# Personalized-Quiz-Service -- settings for a deployment. Copy to .env (never commit .env) or set these as the
# platform's environment variables. Every other setting in app/core/config.py has a working default.

# ── Service ──────────────────────────────────────────────────────────────────
# production (default): no /docs, closed CORS, INFO logging, AUTH_BYPASS ignored. Only use "development" locally.
ENVIRONMENT=production
PROJECT_NAME=Personalized Quiz Service

# ── Database (required) ──────────────────────────────────────────────────────
# The shared Neon Postgres (also used by Quiz-Battle-Service). asyncpg driver, pooled host, no query string.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb

# ── Clerk auth (required) ────────────────────────────────────────────────────
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# Optional checks on the token's aud / azp claims (empty = not checked).
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
# Optional (sk_...): lets POST /user/sync read the username from Clerk instead of trusting the client.
CLERK_SECRET_KEY=
# Comma-separated Clerk user ids allowed to use the admin endpoints.
ADMIN_CLERK_IDS=

# ── Groq (required) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Textbook knowledge base (RAG) ────────────────────────────────────────────
RAG_ENABLED=true
# Where Qdrant runs, reachable from the container (not localhost). Qdrant Cloud: its URL plus an API key.
QDRANT_URL=https://YOUR-CLUSTER.REGION.aws.cloud.qdrant.io
QDRANT_API_KEY=
QUIZ_KNOWLEDGE_COLLECTION=pdf_knowledge_base_v2
# Record which textbook page each AI question came from -- needs alembic migration f7c1e2d3a4b5 (the image applies
# migrations on start unless RUN_MIGRATIONS=false).
RAG_PROVENANCE_COLUMNS_ENABLED=true
# The models are baked into the Docker image at build time (scripts/download_models.py). Changing one of these at
# runtime only works if the image was built with the same value.
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_SPARSE_MODEL=Qdrant/bm25

# ── Container (read by the Dockerfile's start command) ───────────────────────
# Run `alembic upgrade head` on start. Set false when running several copies and run migrations once yourself.
RUN_MIGRATIONS=true
# Uvicorn worker processes. Each one loads the models (~1.5-2 GB RAM) and keeps its own rate limits and cache.
WEB_CONCURRENCY=1
